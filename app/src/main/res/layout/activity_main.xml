<?xml version="1.0" encoding="utf-8"?>
<!--
  LAYOUT ARCHITECTURE
  ═══════════════════
  Layer 0 — TextureView (full-bleed, 100% screen, z=0)
  Layer 1 — Recording HUD badge (top-start of camera, alpha=0 when idle, z=1)
  Layer 2 — Glass control panel (right-anchored, 43% width, semi-transparent, z=2)

  The panel sits ON TOP of the camera. Its 88%-opacity background lets the
  camera bleed through subtly — the panel reads as floating over the scene,
  not walling it off. This is the core layout change from the old 55/45 split.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ══ LAYER 0 — Full-bleed camera ═══════════════════════════════════════ -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══ LAYER 1a — Status pill (top-left, always visible) ════════════════ -->
    <!--
      Idle   → green dot  + "Ready"
      Record → red dot    + "Rec"    (dot breathes at 900ms)
    -->
    <LinearLayout
        android:id="@+id/statusOverlayPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/hud_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/vOverlayStatusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_ready"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="@color/mango_text_primary"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- ══ LAYER 1b — Bottom-left stacked pills ══════════════════════════════ -->
    <!--
      Pill 1: "chunk  MM:SS"  — elapsed time in current chunk (resets at boundary)
      Pill 2: "upload in MM:SS" ← countdown while recording
              "● Uploading..."  ← while WorkManager running
              "● Uploaded"      ← 3 s after upload completes
      Both hidden (alpha=0) when idle.
    -->
    <LinearLayout
        android:id="@+id/bottomOverlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Upload status pill -->
        <LinearLayout
            android:id="@+id/uploadOverlayPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/hud_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:alpha="0">

            <View
                android:id="@+id/vUploadOverlayDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUploadOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="upload in  00:00"
                android:textColor="@color/mango_text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══ LAYER 2 — Glass control panel ════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/control_panel_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.43">

        <!-- ── Scrollable settings ─────────────────────────────────────────── -->
        <com.vixcy.mango.MangoScrollView
            android:id="@+id/controlScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:scrollbars="none"
            android:overScrollMode="always">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipChildren="false">

                <!-- STATUS CHIP ──────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/statusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/status_chip_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginBottom="20dp">

                    <View
                        android:id="@+id/vStatusDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_ready"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textColor="@color/mango_text_primary"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <!-- QUALITY ─────────────────────────────────────────────── -->
                <TextView
                    android:id="@+id/tvLabelQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QUALITY"
                    android:textColor="@color/mango_text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.6" />

                <!--
                  Segmented control: FrameLayout(track) + View(sliding pill) +
                  LinearLayout(text options). The pill's position and size are
                  set programmatically in SegmentedControl.kt after first layout.
                -->
                <FrameLayout
                    android:id="@+id/qualitySelector"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/segmented_track"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/qualityPill"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_gravity="top|start"
                        android:background="@drawable/seg_pill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/seg720p"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:gravity="center"
                            android:text="720p" android:textSize="12sp"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/seg1080p"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:gravity="center"
                            android:text="1080p" android:textSize="11sp"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/seg4k"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:gravity="center"
                            android:text="4K" android:textSize="12sp"
                            android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </FrameLayout>

                <!-- FRAME RATE ───────────────────────────────────────────── -->
                <TextView
                    android:id="@+id/tvLabelFrameRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FRAME RATE"
                    android:textColor="@color/mango_text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.14"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.6" />

                <FrameLayout
                    android:id="@+id/fpsSelector"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/segmented_track"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/fpsPill"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_gravity="top|start"
                        android:background="@drawable/seg_pill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/seg24fps"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:gravity="center"
                            android:text="24" android:textSize="12sp"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/seg30fps"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:gravity="center"
                            android:text="30" android:textSize="12sp"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/seg60fps"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:gravity="center"
                            android:text="60" android:textSize="12sp"
                            android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </FrameLayout>

                <!-- CLIP DURATION ────────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLabelDuration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CLIP DURATION"
                        android:textColor="@color/mango_text_secondary"
                        android:textSize="9sp"
                        android:letterSpacing="0.14"
                        android:alpha="0.6" />

                    <TextView
                        android:id="@+id/tvDurationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 min"
                        android:textColor="@color/mango_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="133"
                    android:progress="10"
                    android:layout_marginBottom="10dp"
                    android:thumbOffset="0dp"
                    android:thumb="@drawable/seekbar_thumb"
                    android:progressDrawable="@drawable/seekbar_track"
                    android:maxHeight="4dp" />

                <TextView
                    android:id="@+id/tvFileSizeEstimate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/mango_text_secondary"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.55" />

            </LinearLayout>
        </com.vixcy.mango.MangoScrollView>

        <!-- ── Record button ─────────────────────────────────────────────── -->
        <!--
          Full-width text button. Background is a programmatic GradientDrawable
          (cornerRadius=16dp) so the fill color can animate orange↔red smoothly.
          Text crossfades between "Start Recording" and "Stop Recording".
        -->
        <TextView
            android:id="@+id/btnToggleRecording"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Start Recording"
            android:textColor="@color/mango_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
