<?xml version="1.0" encoding="utf-8"?>
<!--
  PORTRAIT LAYOUT — iOS native camera app architecture
  ═══════════════════════════════════════════════════════
  Layer 0 — TextureView (fills top portion, above bottom panel)
  Layer 1 — Dim overlay (camera area, fades in when settings open)
  Layer 2 — Status pill top-left (always visible)
  Layer 3 — Upload pill bottom-left (above panel, recording only)
  Layer 4 — Settings sheet (slides up above panel, hidden at rest)
  Layer 5 — Bottom panel (solid black, rounded top, always visible)
              • App header  "M  Mango"
              • Summary chips  "720p • 30 fps • 10 min"
              • Record button (centered) + Settings button (right)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ══ LAYER 0 — Camera viewfinder (Full Screen) ═════════════════════ -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══ LAYER 1 — Dim overlay (covers camera, shown when settings open) ═ -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══ LAYER 2 — Status pill (top-left, always visible) ════════════════ -->
    <LinearLayout
        android:id="@+id/statusOverlayPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/hud_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/vOverlayStatusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_ready"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="@color/mango_text_primary"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- ══ LAYER 3 — Upload overlay pill (bottom-left, above panel) ════════ -->
    <LinearLayout
        android:id="@+id/bottomOverlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/uploadOverlayPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/hud_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:alpha="0">

            <View
                android:id="@+id/vUploadOverlayDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUploadOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="upload in  00:00"
                android:textColor="@color/mango_text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══ LAYER 4 — Settings sheet (slides up, hidden at rest) ════════════ -->
    <!--
      Natural position is just above the bottom panel.
      Hidden by translationY = sheet.height (pushed down behind panel).
      Revealed by animating translationY back to 0.
    -->
    <LinearLayout
        android:id="@+id/settingsSheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_sheet_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:background="@color/mango_text_tertiary"
            android:alpha="0.5" />

        <!-- QUALITY -->
        <TextView
            android:id="@+id/tvLabelQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUALITY"
            android:textColor="@color/mango_text_secondary"
            android:textSize="9sp"
            android:letterSpacing="0.14"
            android:layout_marginBottom="6dp"
            android:alpha="0.6" />

        <FrameLayout
            android:id="@+id/qualitySelector"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/segmented_track"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/qualityPill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:background="@drawable/seg_pill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView android:id="@+id/seg720p"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:text="720p" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/seg1080p"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:text="1080p" android:textSize="11sp"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/seg4k"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:text="4K" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- FRAME RATE -->
        <TextView
            android:id="@+id/tvLabelFrameRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FRAME RATE"
            android:textColor="@color/mango_text_secondary"
            android:textSize="9sp"
            android:letterSpacing="0.14"
            android:layout_marginBottom="6dp"
            android:alpha="0.6" />

        <FrameLayout
            android:id="@+id/fpsSelector"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/segmented_track"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/fpsPill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:background="@drawable/seg_pill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView android:id="@+id/seg24fps"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:text="24" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/seg30fps"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:text="30" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/seg60fps"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:text="60" android:textSize="12sp"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- CLIP DURATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLabelDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CLIP DURATION"
                android:textColor="@color/mango_text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.14"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/tvDurationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 min"
                android:textColor="@color/mango_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="133"
            android:progress="10"
            android:layout_marginBottom="8dp"
            android:thumbOffset="0dp"
            android:thumb="@drawable/seekbar_thumb"
            android:progressDrawable="@drawable/seekbar_track"
            android:maxHeight="4dp" />

        <TextView
            android:id="@+id/tvFileSizeEstimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/mango_text_secondary"
            android:textSize="10sp"
            android:gravity="center"
            android:alpha="0.55"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/recordButtonArea"
            app:layout_constraintTop_toTopOf="@id/recordButtonArea"
            app:layout_constraintBottom_toBottomOf="@id/recordButtonArea"
            android:layout_marginStart="20dp" />

    </LinearLayout>


    <!-- ══ LAYER 5 — Bottom control panel ══════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bottom_panel_bg"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App header: icon + name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/ic_launcher_round"
                android:layout_marginEnd="8dp"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mango"
                android:textColor="@color/mango_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <!-- Summary chips: 720p • 30 fps • 10 min -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvSummaryQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="720p"
                android:textColor="@color/mango_text_primary"
                android:textSize="13sp"
                android:background="@drawable/summary_chip_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textColor="@color/mango_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSummaryFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 fps"
                android:textColor="@color/mango_text_primary"
                android:textSize="13sp"
                android:background="@drawable/summary_chip_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textColor="@color/mango_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSummaryDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 min"
                android:textColor="@color/mango_text_primary"
                android:textSize="13sp"
                android:background="@drawable/summary_chip_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

        <!-- Action row: record button (center) + settings button (right) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <!-- Primary File size estimate (left of record button) -->
            <TextView
                android:id="@+id/tvFileSizeEstimateMain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mango_text_secondary"
                android:textSize="10sp"
                android:gravity="center"
                android:alpha="0.55"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/recordButtonArea"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="16dp" />

            <!-- Record button — centered -->
            <FrameLayout
                android:id="@+id/recordButtonArea"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Dark outer casing -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/record_ring_outer" />

                <!-- Inner coloured circle (GradientDrawable, set in code) -->
                <View
                    android:id="@+id/btnToggleRecording"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />

            </FrameLayout>

            <!-- Settings gear button — right of record button -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/settings_btn_bg"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toEndOf="@id/recordButtonArea"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
